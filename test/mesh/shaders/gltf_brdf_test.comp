#version 460
#extension GL_GOOGLE_include_directive : require
#include "reference/gltf_transport.glsl"
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) buffer Results { vec4 values[]; } results;
void main() {
    vec3 n = vec3(0, 0, 1), c = vec3(0.2, 0.4, 0.8);
    results.values[0] = vec4(gltf_brdf(c, 0, 1, n, n, n), 1);
    results.values[1] = vec4(gltf_brdf(c, 1, 1, n, n, n), 1);
    results.values[2] = vec4(gltf_brdf(c, 0.5, 1, n, n, n), 1);
    vec3 v = normalize(vec3(0.2, 0.3, 1)), l = normalize(vec3(-0.4, 0.1, 1));
    results.values[3] = vec4(gltf_brdf(c, 0.4, 0.3, n, v, l), 1);
    results.values[4] = vec4(gltf_brdf(c, 0.4, 0.3, n, l, v), 1);
    results.values[5] = vec4(gltf_brdf(c, 0.5, 0, n, n, n), 1);
    results.values[6] = vec4(gltf_brdf(c, 0.5, 0.5, n, n, -n), 1);
    results.values[7] = vec4(gltf_brdf(c, 0.5, 0.5, n, normalize(vec3(1,0,0.0001)), n), 1);
    results.values[8] = vec4(gltf_f0(1.0), gltf_f0(1.5), gltf_f0(2.0), gltf_f0(0.0));
    results.values[9] = vec4(gltf_brdf(c, 0, 1, n, n, n, 1.0, 0.0), 1);
    results.values[10] = vec4(gltf_brdf(c, 0, 1, n, n, n, 1.5, 1.0), 1);
    results.values[11] = vec4(gltf_brdf(c, 0, 1, n, n, n, 0.0, 1.0), 1);
    gltf_scene scene;
    scene.light_direction = vec4(n, 0);
    scene.light_radiance = vec4(0);
    scene.ambient_irradiance = vec4(0);
    gltf_material material;
    material.base_color = vec4(1);
    material.emissive_metallic = vec4(0);
    material.roughness_normal_occlusion_cutoff = vec4(0, 1, 1, 0.5);
    material.flags = ivec4(0);
    material.specular = vec4(1);
    material.clearcoat = vec4(0,0,1,0);
    material.sheen = vec4(0);
    material.anisotropy = vec4(0,1,0,0);
    material.iridescence = vec4(0,1.3,100,400);
    material.optical = vec4(1.5, 1, 1, 0);
    material.attenuation = vec4(1);
    vec4 samples[17];
    for (int i = 0; i < 17; ++i) { material.textures[i] = ivec4(0); samples[i] = vec4(1); }
    gltf_surface surface = gltf_evaluate(scene, material, vec4(1), samples, n, vec3(0.6, 0, -0.8), true, 0u);
    results.values[12] = vec4(surface.direction, surface.weight.x);
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, vec3(0.8, 0, -0.6), false, 0u);
    results.values[13] = vec4(surface.direction, surface.weight.x);
    material.emissive_metallic.w = 1.0;
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, -n, true, 0u);
    results.values[14] = vec4(surface.weight, 1);
    results.values[15] = vec4(gltf_attenuation(vec4(0.5, 0.25, 0.0, 1.0), 1.0), 1);
    results.values[16] = vec4(gltf_attenuation(vec4(0.5, 0.25, 1.0, 1.0), 2.0), 1);
    results.values[17] = vec4(gltf_attenuation(vec4(0.0, 0.0, 0.0, uintBitsToFloat(0x7f800000u)), 10.0), 1);
    material.emissive_metallic.w = 0.0;
    material.optical.z = 0.0;
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, vec3(0.6, 0, -0.8), true, 0u);
    results.values[18] = vec4(surface.direction, 1);
    material.optical.z = 1.0;
    gltf_volume_state volume;
    volume.count = 0;
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, -n, true, 0u, volume, 1u, 0.0);
    material.optical.x = 1.33;
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, vec3(0.6, 0, -0.8), true, 0u, volume, 2u, 0.0);
    results.values[19] = vec4(surface.direction, float(volume.count));
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, -n, false, 0u, volume, 2u, 0.0);
    results.values[20] = vec4(float(volume.count), volume.media[0].ior, surface.weight.x, 1);
    material.optical.x = 1.5;
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, vec3(0.8, 0, -0.6), false, 0u, volume, 1u, 0.0);
    results.values[21] = vec4(surface.direction, float(volume.count));
    surface = gltf_evaluate(scene, material, vec4(1), samples, n, -n, false, 0u, volume, 1u, 0.0);
    results.values[22] = vec4(float(volume.count), surface.weight);
    material.optical = vec4(1.5,0,0,0);
    material.base_color = vec4(c,0.4);
    material.flags = ivec4(2,0,1,0);
    gltf_geometry geometry = gltf_geometry(vec3(0),n,vec3(1,0,0),vec3(0,1,0),n);
    results.values[23] = gltf_shade(scene,material,vec4(1),samples,geometry,n);
    material.flags = ivec4(0);
    material.specular = vec4(1,0.5,0.25,0.5);
    results.values[24] = vec4(gltf_dielectric_fresnel(material,samples,1.0),1);
    results.values[25] = vec4(gltf_dielectric_fresnel(material,samples,0.0),1);
    material.specular = vec4(1);
    material.clearcoat.x = 1.0;
    material.clearcoat.y = 1.0;
    results.values[26] = vec4(gltf_layered_direct(material,samples,geometry,vec3(0),vec2(0,1),0.0,n,n),1);
    material.clearcoat.x = 0.0;
    material.sheen = vec4(0.5,0.25,0.1,0.6);
    results.values[27] = vec4(gltf_layered_direct(material,samples,geometry,c,vec2(0,0.5),0.0,v,l),1);
    material.sheen = vec4(0);
    material.anisotropy.x = 0.9;
    results.values[28] = vec4(gltf_layered_direct(material,samples,geometry,c,vec2(1,0.3),0.0,v,l),1);
    material.anisotropy.yz = vec2(0,1);
    results.values[29] = vec4(gltf_layered_direct(material,samples,geometry,c,vec2(1,0.3),0.0,v,l),1);
    results.values[30] = vec4(gltf_iridescence(1.0,1.3,0.7,350.0,vec3(0.04)),1);
    material.optical = vec4(1.5,1,1,1);
    material.roughness_normal_occlusion_cutoff.x = 0.0;
    volume.count = 0; volume.channel = 0;
    surface = gltf_evaluate(scene,material,vec4(1),samples,n,vec3(0.6,0,-0.8),true,0u,volume,1u,0.0);
    results.values[31] = vec4(surface.direction,volume.media[0].ior);
    volume.count = 0; volume.channel = 2;
    surface = gltf_evaluate(scene,material,vec4(1),samples,n,vec3(0.6,0,-0.8),true,0u,volume,1u,0.0);
    results.values[32] = vec4(surface.direction,volume.media[0].ior);
    material.textures[0].w = 1;
    material.uv_transform[0] = vec4(0,3,-2,0);
    material.uv_offset[0] = vec4(0.2,0.3,0,0);
    results.values[33] = vec4(gltf_uv(material,0,vec2(0.25,0.75)),0,1);
}

