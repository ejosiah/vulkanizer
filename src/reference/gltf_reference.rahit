#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "gltf_ray_surface.glsl"
layout(location = 0) rayPayloadInEXT gltf_ray_payload payload;
void main() {
    uvec4 instance = instances.data[gl_InstanceCustomIndexEXT];
    gltf_material material = materials.data[instance.z];
    uvec3 triangle = triangle_vertices(instance, uint(gl_PrimitiveID));
    vec3 weights = barycentrics();
    float alpha = gltf_base_color(material, fetch_vertex_color(triangle, weights), sample_texture(material, 0, triangle, weights)).a;
    if (gltf_masked(material, alpha)) ignoreIntersectionEXT;
    if (material.flags.x == 2) {
        uint seed = gltf_hash(gl_LaunchIDEXT.x + gl_LaunchSizeEXT.x * gl_LaunchIDEXT.y);
        seed = gltf_hash(seed ^ gltf_hash(reference.sampling.x) ^ gltf_hash(payload.sample_index) ^ gltf_hash(payload.bounce) ^ gltf_hash(uint(gl_InstanceCustomIndexEXT)) ^ gltf_hash(uint(gl_PrimitiveID) + 1));
        float sample_value = float(seed >> 8) * (1.0 / 16777216.0);
        if (sample_value >= clamp(alpha, 0.0, 1.0)) ignoreIntersectionEXT;
    }
}
