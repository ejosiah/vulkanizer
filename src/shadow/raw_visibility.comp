#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

#include "shared.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 4) uniform accelerationStructureEXT scene_acceleration;

#include "surface.glsl"
layout(set = 0, binding = 17, r16f) uniform image3D penumbra_image;

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);
    if (!valid_pixel(p))
        return;

    float visibility = 1;
    float penumbra = 65504;
    if (depth_at(p.xy) < 1) {
        vec3 position = world_at(p.xy);
        vec3 normal = normal_at(p.xy);
        light source = lights[p.z];
        bool directional = source.direction_type.w == 0;
        vec3 delta = source.position_range.xyz - position;
        float distance = directional ? 100 : length(delta);
        vec3 direction = directional ? normalize(-source.direction_type.xyz) : delta / max(distance, 0.001);
        vec3 axis = abs(direction.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
        vec3 tangent = normalize(cross(direction, axis));
        uint seed = uint(p.x) * 747796405u + uint(p.y) * 277803737u + constants.frame_index * 2891336453u;
        seed = (seed ^ (seed >> 16)) * 2246822519u;
        float angle = float(seed) / 4294967296.0 * 6.28318530718;
        float source_radius = source.cone.z > 0 ? source.cone.z : source.position_range.w * 0.01;
        float radius = directional ? 0.01 : source_radius / max(distance, 0.001);
        seed = (seed ^ (seed >> 13)) * 3266489917u;
        float disk_radius = source.cone.z > 0 ? sqrt(float(seed) / 4294967296.0) : 1;
        direction = normalize(direction + radius * disk_radius * (cos(angle) * tangent + sin(angle) * cross(direction, tangent)));
        float shadow_distance = distance;
        if (!directional && source.cone.z > 0) {
            float projection = dot(delta, direction);
            shadow_distance = projection - sqrt(max(source_radius * source_radius - dot(delta, delta) + projection * projection, 0));
        }

        if (dot(normal, direction) <= 0) {
            visibility = 0;
            penumbra = 0;
        } else {
            vec2 shadow = trace_shadow_visibility(position + normal * 0.005, direction, max(shadow_distance - 0.01, 0.011));
            visibility = shadow.x;
            // SIGMA consumes binary occlusion/penumbra samples. Preserve expected
            // blend transmission with a stochastic sample before temporal filtering.
            seed = (seed ^ (seed >> 13)) * 3266489917u;
            visibility = float(seed) / 4294967296.0 < visibility ? 1 : 0;
            if (visibility == 0) {
                float blocker_distance = shadow.y;
                // SIGMA_FrontEnd_PackPenumbra: world-space penumbra radius.
                penumbra = directional ? blocker_distance * 0.005
                    : source_radius * blocker_distance / max(distance - blocker_distance, 1e-6);
                penumbra = min(penumbra, 32768);
            }
        }
    }
    imageStore(filtered_visibility, p, vec4(visibility));
    imageStore(penumbra_image, p, vec4(penumbra));
}
