float trace_visibility(vec3 origin, vec3 direction, float distance) {
    return trace_shadow_visibility(origin, direction, distance).x;
}

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);

    if (!valid_pixel(p))
        return;

    uint slot = constants.frame_index % 4;
    vec4 history = previous_visibility(ivec3(previous_pixel(p.xy), p.z));
    uvec4 counts = imageLoad(sample_count_cache, p);
    vec2 motion = imageLoad(motion_vector, p.xy).xy;

    if (!valid_history(p.xy)) {
        history = vec4(1);
        counts = uvec4(1);
    }

    float variance = imageLoad(filtered_variation, p).r;
    uint previous_count = counts[(slot + 3) % 4];
    uint sample_count = variance > 0.2 ? min(previous_count + 1, 5u) : max(previous_count, 2u) - 1;
    float visibility = 1;

    if (depth_at(p.xy) < 1) {
        vec3 position = world_at(p.xy);
        vec3 normal = normal_at(p.xy);
        light source = lights[p.z];
        bool directional = source.direction_type.w == 0;
        vec3 delta = source.position_range.xyz - position;
        float distance = directional ? 100 : length(delta);
        vec3 direction = directional ? normalize(-source.direction_type.xyz) : delta / max(distance, 0.001);
        vec3 axis = abs(direction.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0);
        vec3 x_axis = normalize(cross(direction, axis));
        vec3 y_axis = cross(direction, x_axis);
        float source_radius = source.cone.z > 0 ? source.cone.z : source.position_range.w * 0.01;
        float radius = directional ? 0.01 : source_radius / max(distance, 0.001);
        visibility = 0;

        if (dot(normal, direction) > 0 && distance > 0.02) {
            for (uint s = 0; s < sample_count; ++s) {
                vec2 disk = poisson_samples[(s * 4 + slot) % 32];
                vec3 ray = normalize(direction + radius * (x_axis * disk.x + y_axis * disk.y));
                float shadow_distance = distance;
                if (!directional && source.cone.z > 0) {
                    float projection = dot(delta, ray);
                    shadow_distance = projection - sqrt(max(source_radius * source_radius - dot(delta, delta) + projection * projection, 0));
                }

                visibility += trace_visibility(position + normal * 0.005, ray, max(shadow_distance - 0.01, 0.011));
            }

            visibility /= float(sample_count);
        }
    }

    if (!valid_history(p.xy))
        history = vec4(visibility);

    history[slot] = visibility;
    counts[slot] = sample_count;

    store_visibility(p, history);
    imageStore(sample_count_cache, p, counts);
}
