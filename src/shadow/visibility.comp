#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

#include "shared.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 4) uniform accelerationStructureEXT scene_acceleration;

#include "surface.glsl"

// Poisson disk samples from Packt chapter13/shaders/lighting.h; see LICENSE.txt.
const vec2 poisson_samples[32] =
{
    vec2( 0.39963964752463255f, 0.8910925368990373f ),
