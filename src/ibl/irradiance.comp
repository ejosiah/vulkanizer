#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube environment_map;
layout(set = 0, binding = 1, rgba32f) writeonly uniform imageCube irradiance_map;

const uint sample_count = 256u;

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec2 size = imageSize(irradiance_map);
    if (any(greaterThanEqual(texel.xy, size)) || texel.z >= 6) return;

    vec3 normal = cube_direction(texel, size);
    vec3 tangent;
    vec3 bitangent;
    tangent_basis(normal, tangent, bitangent);
    vec3 irradiance = vec3(0.0);
    for (uint i = 0; i < sample_count; ++i) {
        vec2 xi = hammersley(i, sample_count);
        float phi = 2.0 * pi * xi.x;
        float cos_theta = sqrt(1.0 - xi.y);
        float sin_theta = sqrt(xi.y);
        vec3 local = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
        vec3 direction = tangent * local.x + bitangent * local.y + normal * local.z;
        irradiance += textureLod(environment_map, direction, 0.0).rgb;
    }
    imageStore(irradiance_map, texel, vec4(pi * irradiance / float(sample_count), 1.0));
}
