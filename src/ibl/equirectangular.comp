#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D source_map;
layout(set = 0, binding = 1, rgba32f) writeonly uniform imageCube environment_map;
void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    ivec2 size = imageSize(environment_map);
    if (any(greaterThanEqual(texel.xy, size)) || texel.z >= 6) return;
    vec3 direction = cube_direction(texel, size);
    vec2 uv = vec2(atan(direction.z, direction.x) / (2.0 * pi) + 0.5, acos(clamp(direction.y, -1.0, 1.0)) / pi);
    imageStore(environment_map, texel, vec4(textureLod(source_map, uv, 0.0).rgb, 1.0));
}
