#version 460

#extension GL_GOOGLE_include_directive : require

#include "shared.glsl"

layout(local_size_x = 64) in;
layout(set = 0, binding = 6, rgba16f) uniform image2D probe_offset_image;

layout(set = 0, binding = 7, rgba16f) uniform readonly image2D probe_hit_geometry_image;

void main() {
    int probe_index = int(gl_GlobalInvocationID.x) + probe_update_offset;

    if (probe_index >= probe_update_offset + probe_update_count)
        return;
    uint backfaces = 0;
    float nearest_backface = max_ray_distance;
    vec3 escape_normal = vec3(0);
    float escape_distance = 0;
    float nearest_frontface = max_ray_distance;
    float farthest_frontface = 0;
    vec3 wall_normal = vec3(0);

    for (int i = 0; i < probe_rays; ++i) {
        float distance = texelFetch(radiance_texture, ivec2(i, probe_index), 0).w;

        vec4 geometry = imageLoad(probe_hit_geometry_image, ivec2(i, probe_index));
        vec3 ray_direction = normalize(mat3(random_rotation) * spherical_fibonacci(i, probe_rays));
        float normal_distance = geometry.w * abs(dot(geometry.xyz, ray_direction));

        if (distance < 0) {
            ++backfaces;

            if (normal_distance < nearest_backface) {
                nearest_backface = normal_distance;
                escape_distance = normal_distance;
                escape_normal = geometry.xyz;
            }
        } else {
            farthest_frontface = max(farthest_frontface, distance);
            if (dot(geometry.xyz, geometry.xyz) > 0.5 && distance < nearest_frontface) {
                nearest_frontface = distance;
                wall_normal = geometry.xyz;
            }
        }
    }

    if (use_probe_status())
        probe_status[probe_index] = backfaces > uint(float(probe_rays) * 0.25) ? PROBE_STATUS_OFF : PROBE_STATUS_ACTIVE;

    if (use_probe_offsetting()) {
        ivec2 pixel = ivec2(probe_index % (probe_counts.x * probe_counts.y), probe_index / (probe_counts.x * probe_counts.y));
        vec3 offset = imageLoad(probe_offset_image, pixel).xyz;
        // Chapter 15: relocate embedded probes, or probes within 5 cm of a surface.
        // Preserve normal-directed movement instead of the reference's ray direction.
        const float clearance = 0.05;
        bool inside_geometry = backfaces > uint(float(probe_rays) * 0.25);

        if (inside_geometry)
            offset += escape_normal * (escape_distance + clearance);
        else if (nearest_frontface < clearance && farthest_frontface > clearance)
            offset += wall_normal * min(0.2, farthest_frontface);

        // Limit the step without changing its normal direction.
        vec3 old_offset = imageLoad(probe_offset_image, pixel).xyz;
        vec3 step = offset - old_offset;
        vec3 limit = probe_spacing * max_offset;
        float step_scale = 1;
        for (int axis = 0; axis < 3; ++axis) {
            if (step[axis] > 0)
                step_scale = min(step_scale, (limit[axis] - old_offset[axis]) / step[axis]);
            else if (step[axis] < 0)
                step_scale = min(step_scale, (-limit[axis] - old_offset[axis]) / step[axis]);
        }
        offset = old_offset + step * clamp(step_scale, 0, 1);
        imageStore(probe_offset_image, pixel, vec4(offset, 0));
    }
}
