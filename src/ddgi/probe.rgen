#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

#include "shared.glsl"

layout(set = 3, binding = 4) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D radiance_image;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D probe_hit_geometry_image;
layout(location = 0) rayPayloadEXT ray_payload payload;

void main() {
    int probe_index = int(gl_LaunchIDEXT.y) + probe_update_offset;
    int ray_index = int(gl_LaunchIDEXT.x);
    vec3 origin = grid_indices_to_world(probe_index_to_grid_indices(probe_index), probe_index);
    vec3 direction = normalize(mat3(random_rotation) * spherical_fibonacci(ray_index, probe_rays));
    payload.radiance = vec3(0);
    payload.distance = max_ray_distance;
    payload.geometric_normal = vec3(0);
    payload.hit_distance = max_ray_distance;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xff, 0, 0, 0, origin, 0.001, direction, max_ray_distance, 0);
    imageStore(probe_hit_geometry_image, ivec2(ray_index, probe_index), vec4(payload.geometric_normal, payload.hit_distance));
    imageStore(radiance_image, ivec2(ray_index, probe_index), vec4(payload.radiance, payload.distance));
}
